# Service configuration (all values are examples)
RIDERGUARD_SERVER_PORT=49660
RIDERGUARD_SERVER_READ_TIMEOUT=30s
RIDERGUARD_SERVER_WRITE_TIMEOUT=30s
RIDERGUARD_SERVER_SHUTDOWN_TIMEOUT=15s
RIDERGUARD_STORAGE_DATA_DIR=./data
RIDERGUARD_STORAGE_SHARD_MAX_SIZE=1048576
RIDERGUARD_STORAGE_SYNC_ON_WRITE=true
RIDERGUARD_SCHEDULER_ESCALATION_INTERVAL=30s
RIDERGUARD_SCHEDULER_RECONCILIATION_INTERVAL=5m
RIDERGUARD_SCHEDULER_REEVAL_INTERVAL=1m
RIDERGUARD_SCHEDULER_MAX_RETRIES=3
RIDERGUARD_SCHEDULER_BASE_BACKOFF=1s
RIDERGUARD_SCHEDULER_TASK_TIMEOUT=10s
RIDERGUARD_LOGGING_LEVEL=info
RIDERGUARD_LOGGING_FORMAT=json
RIDERGUARD_BUSINESS_DEFAULT_DEADLINE=72h
RIDERGUARD_BUSINESS_ESCALATION_DEADLINE_EXTENSION=48h
RIDERGUARD_BUSINESS_MAX_ESCALATION_LEVEL=3
